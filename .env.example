# Copy to .env.local (ignored by Git) and fill in. Leave everything empty to use the local extractive mode.
# Choose ONE provider: anthropic, nebius or gemini
MIHAKK_LLM_PROVIDER=
MIHAKK_LLM_MODEL=
ANTHROPIC_API_KEY=
NEBIUS_API_KEY=
GEMINI_API_KEY=
# Optional: only if your Nebius account uses a different OpenAI-compatible base URL
MIHAKK_LLM_BASE_URL=
